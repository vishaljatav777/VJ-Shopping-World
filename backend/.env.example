PORT=5000
NODE_ENV=development

# PostgreSQL Connection (Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/vj_shopping_world?schema=public"

# MongoDB Connection (Mongoose)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/vj_shopping_world?retryWrites=true&w=majority"

# Redis Connection
REDIS_URL="redis://localhost:6379"

# Security & Secrets
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Cloudinary Image Uploads
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
